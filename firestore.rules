rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Prototype rules for a two-player invite flow backed by durable auth.
    // Review these before sharing broadly.
    function isAuthed() {
      return request.auth != null;
    }

    function hasOnlyKeys(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function isInviteCode(code) {
      return code is string
        && code.size() == 6
        && code.matches('^[A-Z2-9]+$');
    }

    function isCoupleParticipant(data) {
      return isAuthed()
        && data.playerIds is list
        && request.auth.uid in data.playerIds;
    }

    function isParticipant(coupleId) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/couples/$(coupleId)) &&
        request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.playerIds;
    }

    function isJoinableCoupleUpdate() {
      return isAuthed()
        && resource.data.status == 'waiting'
        && resource.data.activeSessionId == null
        && resource.data.playerIds is list
        && resource.data.playerIds.size() == 1
        && !(request.auth.uid in resource.data.playerIds)
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() == 2
        && request.resource.data.playerIds[0] == resource.data.playerIds[0]
        && request.resource.data.playerIds[1] == request.auth.uid
        && request.resource.data.players is list
        && request.resource.data.players.size() == 2
        && request.resource.data.players[0].uid == resource.data.playerIds[0]
        && request.resource.data.players[1].uid == request.auth.uid
        && request.resource.data.players[0].displayName is string
        && request.resource.data.players[1].displayName is string
        && request.resource.data.status == 'paired'
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.shareLink == resource.data.shareLink
        && request.resource.data.activeSessionId == resource.data.activeSessionId
        && request.resource.data.boardState == resource.data.boardState;
    }

    function lobbyExists(lobbyId) {
      return exists(/databases/$(database)/documents/publicLobbies/$(lobbyId));
    }

    match /coupleInvites/{inviteCode} {
      allow create: if isAuthed()
        && isInviteCode(inviteCode)
        && hasOnlyKeys(['coupleId', 'createdAt'])
        && request.resource.data.coupleId is string;

      allow read: if isAuthed();
      allow update: if false;
      allow delete: if isAuthed()
        && resource.data.coupleId is string
        && isParticipant(resource.data.coupleId)
        && get(/databases/$(database)/documents/couples/$(resource.data.coupleId)).data.activeSessionId == null;
    }

    match /playerCouples/{userId} {
      allow create, update: if isAuthed()
        && request.auth.uid == userId
        && hasOnlyKeys(['coupleId', 'createdAt', 'updatedAt'])
        && request.resource.data.coupleId is string;

      allow read: if isAuthed() && request.auth.uid == userId;
      allow delete: if isAuthed() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow create, read, update: if isAuthed()
        && request.auth.uid == userId;

      allow delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if isAuthed()
        && request.resource.data.playerIds is list
        && request.resource.data.playerIds.size() >= 1
        && request.resource.data.playerIds.size() <= 2
        && request.auth.uid in request.resource.data.playerIds;

      allow read: if isCoupleParticipant(resource.data);
      allow update: if isCoupleParticipant(resource.data)
        || isJoinableCoupleUpdate();
      allow delete: if isCoupleParticipant(resource.data)
        && resource.data.activeSessionId == null;
    }

    match /publicLobbies/{lobbyId} {
      allow read: if isAuthed();

      allow create: if isAuthed()
        && request.resource.data.coupleId is string
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.inviteCode is string
        && request.resource.data.shareLink is string
        && request.resource.data.playerCount is int
        && request.resource.data.status is string;

      allow update, delete: if isAuthed()
        && resource.data.coupleId is string
        && isParticipant(resource.data.coupleId);
    }

    match /lobbyMessages/{messageId} {
      allow read: if isAuthed();

      allow create: if isAuthed()
        && request.resource.data.lobbyId is string
        && lobbyExists(request.resource.data.lobbyId)
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 280;

      allow update, delete: if false;
    }

    match /sessions/{sessionId} {
      allow create: if isAuthed()
        && request.resource.data.coupleId is string
        && isParticipant(request.resource.data.coupleId);

      allow read, update: if isParticipant(resource.data.coupleId);
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow create: if isAuthed()
        && request.resource.data.coupleId is string
        && isParticipant(request.resource.data.coupleId);

      allow read, update: if isParticipant(resource.data.coupleId);
      allow delete: if false;
    }

    match /journalEntries/{entryId} {
      allow create: if isAuthed()
        && request.resource.data.coupleId is string
        && isParticipant(request.resource.data.coupleId);

      allow read: if isParticipant(resource.data.coupleId);
      allow update, delete: if false;
    }
  }
}
