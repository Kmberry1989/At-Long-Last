rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // profiles/{uid}
    //   Owner-only profile with displayName, optional email, auth state, and
    //   created/updated/last-seen timestamps. Email is private PII.
    //
    // playerCouples/{uid}
    //   Owner-only pointer to a couple containing that same uid.
    //
    // coupleInvites/{sixCharacterCode}
    //   Exact-document invite lookup linked to a couple with the same code.
    //   Invite collection listing is intentionally denied. Carries the host's
    //   display name and avatar so private rooms can preview an invite without
    //   a public lobby row.
    //
    // couples/{coupleId}
    //   One or two validated players, immutable invite identity, optional
    //   active session pointer, preset, visibility ('private' default,
    //   'public' only with explicit host opt-in), and bounded persistent
    //   board state.
    //
    // publicLobbies/{coupleId}
    //   Authenticated discovery row for a one-player PUBLIC waiting couple.
    //   Private rooms never write this row.
    //
    // coupleProgress/{coupleId}
    //   Cross-night progression for one couple: lifetime hearts, spend,
    //   unlocked tabletop themes, night count, shared streak with freeze
    //   tokens, trophies, koupon wallet, companion creature, anniversary,
    //   and the latest partner nudge.
    //
    // lobbyMessages/{messageId}
    //   Immutable, bounded message authored by the authenticated user and
    //   scoped to an existing open lobby.
    //
    // sessions/{sessionId}
    //   Couple-scoped game state. Couple/player/preset/creation identity is
    //   immutable; active sessions can terminate but cannot be reopened.
    //
    // activities/{activityId}
    //   Couple/session-scoped activity state. Identity is immutable and a
    //   terminal completed/skipped activity cannot be reopened.
    //
    // journalEntries/{entryId}
    //   Immutable, bounded couple/session-scoped scrapbook entry.
    //
    // ===============================================================
    // Shared helpers
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.auth.uid == userId;
    }

    function uidNotModified(userId) {
      return request.auth.uid == userId;
    }

    function isBoundedString(value, minSize, maxSize) {
      return value is string
        && value.size() >= minSize
        && value.size() <= maxSize;
    }

    function isOptionalBoundedString(data, field, maxSize) {
      return !(field in data)
        || data[field] == null
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function hasOnlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isInviteCode(code) {
      return code is string
        && code.size() == 6
        && code.matches('^[A-Z2-9]+$');
    }

    function isPreset(value) {
      return value in ['quick', 'standard', 'long'];
    }

    function isVibe(value) {
      return value in ['tender', 'playful', 'spicy'];
    }

    function hasNoActiveSession(data) {
      return !('activeSessionId' in data) || data.activeSessionId == null;
    }

    function isValidColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidPlayer(player, uid) {
      return player is map
        && player.keys().hasAll(['uid', 'displayName', 'color', 'accent', 'avatar'])
        && player.keys().hasOnly(['uid', 'displayName', 'color', 'accent', 'avatar'])
        && player.uid == uid
        && isBoundedString(player.displayName, 1, 60)
        && isValidColor(player.color)
        && isValidColor(player.accent)
        && isBoundedString(player.avatar, 1, 160)
        && player.avatar.matches('^/assets/players/[a-zA-Z0-9._-]+$');
    }

    function isValidPlayers(playerIds, players) {
      return playerIds is list
        && players is list
        && playerIds.size() >= 1
        && playerIds.size() <= 2
        && players.size() == playerIds.size()
        && isBoundedString(playerIds[0], 1, 128)
        && isValidPlayer(players[0], playerIds[0])
        && (
          playerIds.size() == 1
          || (
            isBoundedString(playerIds[1], 1, 128)
            && playerIds[1] != playerIds[0]
            && isValidPlayer(players[1], playerIds[1])
          )
        );
    }

    function isCoupleParticipantData(data) {
      return isAuthenticated()
        && data.playerIds is list
        && request.auth.uid in data.playerIds;
    }

    function coupleExists(coupleId) {
      return exists(/databases/$(database)/documents/couples/$(coupleId));
    }

    function coupleExistsAfter(coupleId) {
      return existsAfter(/databases/$(database)/documents/couples/$(coupleId));
    }

    function coupleData(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function coupleDataAfter(coupleId) {
      return getAfter(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function isParticipant(coupleId) {
      return isAuthenticated()
        && coupleExists(coupleId)
        && isCoupleParticipantData(coupleData(coupleId));
    }

    function isParticipantAfter(coupleId) {
      return isAuthenticated()
        && coupleExistsAfter(coupleId)
        && isCoupleParticipantData(coupleDataAfter(coupleId));
    }

    function isValidBoardState(data) {
      return data is map
        && data.keys().hasAll(['playfulStickerIds', 'spicyGlowLevel', 'tenderStars'])
        && data.keys().hasOnly(['playfulStickerIds', 'spicyGlowLevel', 'tenderStars'])
        && data.playfulStickerIds is list
        && data.playfulStickerIds.size() <= 24
        && data.playfulStickerIds.toSet().size() == data.playfulStickerIds.size()
        && data.spicyGlowLevel is int
        && data.spicyGlowLevel >= 0
        && data.spicyGlowLevel <= 5
        && data.tenderStars is int
        && data.tenderStars >= 0
        && data.tenderStars <= 100;
    }

    function isValidCouple(data) {
      return data.keys().hasAll([
          'inviteCode',
          'shareLink',
          'status',
          'playerIds',
          'players'
        ])
        && data.keys().hasOnly([
          'inviteCode',
          'shareLink',
          'sessionPreset',
          'status',
          'playerIds',
          'players',
          'activeSessionId',
          'boardState',
          'visibility',
          'commitments', 'commitmentEmails', 'committedAt',
          'createdAt',
          'updatedAt'
        ])
        && isInviteCode(data.inviteCode)
        && isBoundedString(data.shareLink, 12, 500)
        && data.shareLink.matches('^https?://.{1,450}/[?](code|invite)=' + data.inviteCode + '$')
        && data.status in ['waiting', 'paired', 'unpaired']
        && (!('visibility' in data) || data.visibility in ['private', 'public'])
        && isValidPlayers(data.playerIds, data.players)
        && (
          data.status == 'unpaired'
          || (data.status == 'waiting' && data.playerIds.size() == 1)
          || (data.status == 'paired' && data.playerIds.size() == 2)
        )
        && (!('commitments' in data) || (data.commitments is list && data.commitments.size() <= 2 && data.commitments.toSet().size() == data.commitments.size() && data.playerIds.hasAll(data.commitments)))
        && (!('commitmentEmails' in data) || (data.commitmentEmails is map && data.commitmentEmails.keys().hasOnly(data.get('commitments', [])) && data.commitmentEmails.keys().hasAll(data.get('commitments', []))))
        && (!('committedAt' in data) || data.committedAt is timestamp)
        && (!('sessionPreset' in data) || isPreset(data.sessionPreset))
        && (
          !('activeSessionId' in data)
          || data.activeSessionId == null
          || isBoundedString(data.activeSessionId, 1, 128)
        )
        && (!('boardState' in data) || isValidBoardState(data.boardState))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidCurrentCoupleWrite() {
      return isValidCouple(request.resource.data)
        && 'createdAt' in request.resource.data
        && request.resource.data.createdAt is timestamp
        && 'updatedAt' in request.resource.data
        && request.resource.data.updatedAt == request.time;
    }

    // ===============================================================
    // Invite and couple lifecycle validators
    // ===============================================================

    function isValidInvite(data, inviteCode) {
      return data.keys().hasAll(['coupleId', 'createdAt'])
        && data.keys().hasOnly(['coupleId', 'createdAt', 'hostName', 'hostAvatar', 'hostId'])
        && (!('hostId' in data) || data.hostId == request.auth.uid)
        && isBoundedString(data.coupleId, 1, 128)
        && data.createdAt == request.time
        && isInviteCode(inviteCode)
        && isOptionalBoundedString(data, 'hostName', 60)
        && (
          !('hostAvatar' in data)
          || data.hostAvatar == null
          || (
            data.hostAvatar is string
            && data.hostAvatar.size() >= 1
            && data.hostAvatar.size() <= 160
            && data.hostAvatar.matches('^/assets/players/[a-zA-Z0-9._-]+$')
          )
        );
    }

    function isValidPlayerCoupleLink(data) {
      return data.keys().hasAll(['coupleId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['coupleId', 'createdAt', 'updatedAt'])
        && isBoundedString(data.coupleId, 1, 128)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPublicLobby(data, lobbyId) {
      return data.keys().hasAll([
          'coupleId',
          'hostAvatar',
          'hostId',
          'hostName',
          'inviteCode',
          'playerCount',
          'shareLink',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'coupleId',
          'hostAvatar',
          'hostId',
          'hostName',
          'inviteCode',
          'playerCount',
          'shareLink',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.coupleId == lobbyId
        && isBoundedString(data.hostAvatar, 1, 160)
        && data.hostAvatar.matches('^/assets/players/[a-zA-Z0-9._-]+$')
        && isBoundedString(data.hostId, 1, 128)
        && isBoundedString(data.hostName, 1, 60)
        && isInviteCode(data.inviteCode)
        && data.playerCount == 1
        && isBoundedString(data.shareLink, 12, 500)
        && data.status == 'open'
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function lobbyMatchesCouple(data, couple) {
      return couple.status == 'waiting'
        && couple.visibility == 'public'
        && hasNoActiveSession(couple)
        && couple.playerIds.size() == 1
        && data.hostAvatar == couple.players[0].avatar
        && data.hostId == couple.playerIds[0]
        && data.hostName == couple.players[0].displayName
        && data.inviteCode == couple.inviteCode
        && data.shareLink == couple.shareLink;
    }

    function lobbyVisibilityMatches(after, coupleId) {
      return (
        (
          after.visibility == 'public'
          && existsAfter(
            /databases/$(database)/documents/publicLobbies/$(coupleId)
          )
        )
        || (
          after.visibility == 'private'
          && !existsAfter(
            /databases/$(database)/documents/publicLobbies/$(coupleId)
          )
        )
      );
    }

    function emailLockKey(email) {
      return email.lower().replace('%', '%25').replace('/', '%2F');
    }

    function isPermanentPair(data) {
      return data.get('commitments', []).size() == 2
        && data.get('commitmentEmails', {}).size() == 2;
    }

    function canConnect() {
      let link = /databases/$(database)/documents/playerCouples/$(request.auth.uid);
      let email = request.auth.token.get('email', '');
      return email.size() > 0
        && !exists(/databases/$(database)/documents/pairingLocks/$(emailLockKey(email)))
        && (!exists(link) || !coupleExists(get(link).data.coupleId)
          || coupleData(get(link).data.coupleId).status == 'unpaired');
    }

    function isActiveParticipant(coupleId) {
      return isParticipant(coupleId) && coupleData(coupleId).status != 'unpaired';
    }

    function isPairingJoinUpdate(coupleId) {
      let before = resource.data;
      let after = request.resource.data;
      return before.status == 'waiting' && !isCoupleParticipantData(before)
        && canConnect() && hasNoActiveSession(before)
        && hasOnlyChanged(['playerIds', 'players', 'status', 'updatedAt'])
        && after.status == 'paired' && after.updatedAt == request.time
        && after.playerIds == [before.playerIds[0], request.auth.uid]
        && after.players.size() == 2 && after.players[0] == before.players[0]
        && isValidPlayer(after.players[1], request.auth.uid)
        && (exists(/databases/$(database)/documents/emailInvitations/$(coupleId))
          ? (isEmailRecipient(get(/databases/$(database)/documents/emailInvitations/$(coupleId)).data)
            && get(/databases/$(database)/documents/emailInvitations/$(coupleId)).data.status == 'pending'
            && !existsAfter(/databases/$(database)/documents/emailInvitations/$(coupleId)))
          : (exists(/databases/$(database)/documents/coupleInvites/$(before.inviteCode))
            && !existsAfter(/databases/$(database)/documents/coupleInvites/$(before.inviteCode))))
        && getAfter(/databases/$(database)/documents/playerCouples/$(request.auth.uid)).data.coupleId == coupleId
        && !existsAfter(/databases/$(database)/documents/publicLobbies/$(coupleId));
    }

    function isCommitUpdate(coupleId) {
      let before = resource.data;
      let after = request.resource.data;
      let old = before.get('commitments', []);
      let emails = before.get('commitmentEmails', {});
      let uid = request.auth.uid;
      let email = request.auth.token.get('email', '').lower();
      return isCoupleParticipantData(before) && before.status == 'paired'
        && request.auth.token.get('email_verified', false) && email.size() > 0
        && hasOnlyChanged(['commitments', 'commitmentEmails', 'committedAt', 'updatedAt'])
        && after.updatedAt == request.time
        && after.commitments is list && after.commitments.size() == old.size() + 1
        && after.commitments.size() <= 2 && after.commitments.toSet().size() == after.commitments.size()
        && after.commitments.hasAll(old) && after.commitments.hasAll([uid]) && !old.hasAny([uid])
        && before.playerIds.hasAll(after.commitments)
        && after.commitmentEmails is map
        && after.commitmentEmails.diff(emails).affectedKeys().hasOnly([uid])
        && after.commitmentEmails[uid] == email
        && after.commitmentEmails.keys().hasAll(after.commitments)
        && after.commitmentEmails.keys().hasOnly(after.commitments)
        && !exists(/databases/$(database)/documents/pairingLocks/$(emailLockKey(email)))
        && (after.commitments.size() == 1
          ? !('committedAt' in after)
          : (after.committedAt == request.time
            && existsAfter(/databases/$(database)/documents/pairingLocks/$(emailLockKey(after.commitmentEmails[before.playerIds[0]])))
            && existsAfter(/databases/$(database)/documents/pairingLocks/$(emailLockKey(after.commitmentEmails[before.playerIds[1]])))
            && getAfter(/databases/$(database)/documents/pairingLocks/$(emailLockKey(after.commitmentEmails[before.playerIds[0]]))).data.coupleId == coupleId
            && getAfter(/databases/$(database)/documents/pairingLocks/$(emailLockKey(after.commitmentEmails[before.playerIds[1]]))).data.coupleId == coupleId));
    }

    function isUnpairUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return isCoupleParticipantData(before) && before.status != 'unpaired'
        && !isPermanentPair(before)
        && hasOnlyChanged(['status', 'activeSessionId', 'visibility', 'updatedAt'])
        && after.status == 'unpaired' && after.activeSessionId == null
        && after.visibility == 'private' && after.updatedAt == request.time;
    }

    function isPairingNightUpdate(coupleId) {
      let before = resource.data;
      let after = request.resource.data;
      return isCoupleParticipantData(before) && before.status == 'paired'
        && hasOnlyChanged(['activeSessionId', 'sessionPreset', 'updatedAt'])
        && isPreset(after.sessionPreset) && after.updatedAt == request.time
        && isBoundedString(after.activeSessionId, 1, 128)
        && after.activeSessionId != before.activeSessionId
        && (hasNoActiveSession(before)
          || get(/databases/$(database)/documents/sessions/$(before.activeSessionId)).data.status in ['completed', 'abandoned'])
        && existsAfter(/databases/$(database)/documents/sessions/$(after.activeSessionId))
        && getAfter(/databases/$(database)/documents/sessions/$(after.activeSessionId)).data.coupleId == coupleId
        && getAfter(/databases/$(database)/documents/sessions/$(after.activeSessionId)).data.status == 'active';
    }

    function isDetachNightUpdate(coupleId) {
      let before = resource.data;
      let after = request.resource.data;
      return isCoupleParticipantData(before)
        && hasOnlyChanged(['activeSessionId', 'updatedAt'])
        && isBoundedString(before.activeSessionId, 1, 128)
        && after.activeSessionId == null && after.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/sessions/$(before.activeSessionId))
        && getAfter(/databases/$(database)/documents/sessions/$(before.activeSessionId)).data.coupleId == coupleId
        && getAfter(/databases/$(database)/documents/sessions/$(before.activeSessionId)).data.status in ['completed', 'abandoned'];
    }

    function isPairingUpdate(coupleId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['commitments', 'commitmentEmails', 'committedAt']) ? isCommitUpdate(coupleId)
        : request.resource.data.status == 'unpaired' ? isUnpairUpdate()
        : resource.data.status == 'waiting' && request.resource.data.status == 'paired' ? isPairingJoinUpdate(coupleId)
        : changed.hasAny(['activeSessionId', 'sessionPreset']) && changed.hasOnly(['activeSessionId', 'sessionPreset', 'updatedAt'])
          ? (request.resource.data.activeSessionId == null ? isDetachNightUpdate(coupleId) : isPairingNightUpdate(coupleId))
        : changed.hasOnly(['boardState', 'updatedAt']) ? isValidBoardRewardUpdate()
        : isValidCoupleLifecycleUpdateCompact(coupleId);
    }

    function isValidCoupleCreate(coupleId) {
      let data = request.resource.data;
      return isValidCurrentCoupleWrite()
        && canConnect()
        && data.playerIds.size() == 1
        && data.playerIds[0] == request.auth.uid
        && data.status == 'waiting'
        && data.visibility in ['private', 'public']
        && hasNoActiveSession(data)
        && 'sessionPreset' in data
        && 'boardState' in data
        && data.createdAt == request.time
        && existsAfter(
          /databases/$(database)/documents/playerCouples/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/playerCouples/$(request.auth.uid)
        ).data.coupleId == coupleId
        && ((existsAfter(/databases/$(database)/documents/emailInvitations/$(coupleId))
            && getAfter(/databases/$(database)/documents/emailInvitations/$(coupleId)).data.senderId == request.auth.uid)
          || (existsAfter(/databases/$(database)/documents/coupleInvites/$(data.inviteCode))
            && getAfter(/databases/$(database)/documents/coupleInvites/$(data.inviteCode)).data.coupleId == coupleId))
        && (
          (
            data.visibility == 'public'
            && existsAfter(
              /databases/$(database)/documents/publicLobbies/$(coupleId)
            )
            && lobbyMatchesCouple(
              getAfter(
                /databases/$(database)/documents/publicLobbies/$(coupleId)
              ).data,
              data
            )
          )
          || (
            data.visibility == 'private'
            && !existsAfter(
              /databases/$(database)/documents/publicLobbies/$(coupleId)
            )
          )
        );
    }

    // Rewards touch only board decoration. Evaluate this small path before
    // the relational lobby/session lifecycle checks to stay within the budget.
    function isValidBoardRewardUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let old = before.boardState;
      let next = after.boardState;
      return isCoupleParticipantData(before)
        && after.diff(before).affectedKeys().hasOnly(['boardState', 'updatedAt'])
        && after.updatedAt == request.time
        && isValidBoardState(next)
        && (
          next == old
          || (next.tenderStars == old.tenderStars + 1
            && next.spicyGlowLevel == old.spicyGlowLevel
            && next.playfulStickerIds == old.playfulStickerIds)
          || (next.spicyGlowLevel == old.spicyGlowLevel + 1
            && next.tenderStars == old.tenderStars
            && next.playfulStickerIds == old.playfulStickerIds)
          || (next.playfulStickerIds.size() == old.playfulStickerIds.size() + 1
            && next.playfulStickerIds.toSet().hasAll(old.playfulStickerIds)
            && next.tenderStars == old.tenderStars
            && next.spicyGlowLevel == old.spicyGlowLevel)
        );
    }

    function isValidCoupleLifecycleUpdateCompact(coupleId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let callerWasParticipant = isCoupleParticipantData(before);
      return isValidCurrentCoupleWrite()
        && after.createdAt == before.createdAt
        && (
          (
            callerWasParticipant
            && changed.hasOnly(['activeSessionId', 'updatedAt'])
            && (
              hasNoActiveSession(before)
                ? (
                  before.playerIds[0] == request.auth.uid
                  && isBoundedString(after.activeSessionId, 1, 128)
                  && existsAfter(
                    /databases/$(database)/documents/sessions/$(after.activeSessionId)
                  )
                  && getAfter(
                    /databases/$(database)/documents/sessions/$(after.activeSessionId)
                  ).data.coupleId == coupleId
                  && getAfter(
                    /databases/$(database)/documents/sessions/$(after.activeSessionId)
                  ).data.status == 'active'
                )
                : (
                  after.activeSessionId == null
                  && existsAfter(
                    /databases/$(database)/documents/sessions/$(before.activeSessionId)
                  )
                  && getAfter(
                    /databases/$(database)/documents/sessions/$(before.activeSessionId)
                  ).data.coupleId == coupleId
                  && getAfter(
                    /databases/$(database)/documents/sessions/$(before.activeSessionId)
                  ).data.status in ['abandoned', 'completed']
                )
            )
          )
          || (
            !callerWasParticipant
            && canConnect()
            && changed.hasOnly(['playerIds', 'players', 'status', 'updatedAt'])
            && before.status == 'waiting'
            && hasNoActiveSession(before)
            && before.playerIds.size() == 1
            && after.status == 'paired'
            && after.playerIds == [before.playerIds[0], request.auth.uid]
            && after.players[0] == before.players[0]
            && isValidPlayer(after.players[1], request.auth.uid)
            && after.inviteCode == before.inviteCode
            && after.shareLink == before.shareLink
            && hasNoActiveSession(after)
            && existsAfter(
              /databases/$(database)/documents/playerCouples/$(request.auth.uid)
            )
            && getAfter(
              /databases/$(database)/documents/playerCouples/$(request.auth.uid)
            ).data.coupleId == coupleId
            && !existsAfter(
              /databases/$(database)/documents/publicLobbies/$(coupleId)
            )
          )
          || (
            callerWasParticipant
            && (
              (
                changed.hasOnly([
                  'playerIds', 'players', 'status', 'updatedAt'
                ])
                && before.playerIds.size() == 2
                && hasNoActiveSession(before)
                && after.status == 'waiting'
                && after.playerIds.size() == 1
                && !(request.auth.uid in after.playerIds)
                && after.players.size() == 1
                && (
                  (
                    after.playerIds[0] == before.playerIds[0]
                    && after.players[0] == before.players[0]
                  )
                  || (
                    after.playerIds[0] == before.playerIds[1]
                    && after.players[0] == before.players[1]
                  )
                )
                && !existsAfter(
                  /databases/$(database)/documents/playerCouples/$(request.auth.uid)
                )
                && lobbyVisibilityMatches(after, coupleId)
              )
              || (
                changed.hasOnly(['sessionPreset', 'updatedAt'])
                && before.playerIds[0] == request.auth.uid
                && hasNoActiveSession(before)
                && isPreset(after.sessionPreset)
              )
              || (
                changed.hasOnly(['visibility', 'updatedAt'])
                && before.playerIds[0] == request.auth.uid
                && hasNoActiveSession(before)
                && before.status == 'waiting'
                && after.visibility in ['private', 'public']
                && after.visibility != before.visibility
                && lobbyVisibilityMatches(after, coupleId)
              )
              || (
                changed.hasOnly(['boardState', 'updatedAt'])
                && isValidBoardState(after.boardState)
                && (
                  (
                    after.boardState.tenderStars
                      == before.boardState.tenderStars + 1
                    && after.boardState.spicyGlowLevel
                      == before.boardState.spicyGlowLevel
                    && after.boardState.playfulStickerIds
                      == before.boardState.playfulStickerIds
                  )
                  || (
                    before.boardState.spicyGlowLevel < 5
                    && after.boardState.spicyGlowLevel
                      == before.boardState.spicyGlowLevel + 1
                    && after.boardState.tenderStars
                      == before.boardState.tenderStars
                    && after.boardState.playfulStickerIds
                      == before.boardState.playfulStickerIds
                  )
                  || (
                    after.boardState.playfulStickerIds.size()
                      == before.boardState.playfulStickerIds.size() + 1
                    && after.boardState.playfulStickerIds.toSet()
                      .hasAll(before.boardState.playfulStickerIds)
                    && after.boardState.tenderStars
                      == before.boardState.tenderStars
                    && after.boardState.spicyGlowLevel
                      == before.boardState.spicyGlowLevel
                  )
                )
              )
            )
          )
        );
    }

    function isValidLastParticipantDelete(coupleId) {
      return isCoupleParticipantData(resource.data)
        && resource.data.playerIds.size() == 1
        && request.auth.uid == resource.data.playerIds[0]
        && hasNoActiveSession(resource.data)
        && !existsAfter(
          /databases/$(database)/documents/playerCouples/$(request.auth.uid)
        )
        && !existsAfter(
          /databases/$(database)/documents/publicLobbies/$(coupleId)
        )
        && !existsAfter(
          /databases/$(database)/documents/coupleInvites/$(resource.data.inviteCode)
        );
    }

    function isCompletedLobbyJoin(lobbyId) {
      let couple = coupleDataAfter(resource.data.coupleId);
      return isAuthenticated()
        && resource.data.coupleId == lobbyId
        && resource.data.status == 'open'
        && resource.data.playerCount == 1
        && couple.status == 'paired'
        && couple.playerIds.size() == 2
        && couple.players[0].avatar == resource.data.hostAvatar
        && couple.playerIds[0] == resource.data.hostId
        && couple.playerIds[1] == request.auth.uid
        && couple.players[0].displayName == resource.data.hostName
        && couple.inviteCode == resource.data.inviteCode
        && couple.shareLink == resource.data.shareLink
        && existsAfter(
          /databases/$(database)/documents/playerCouples/$(request.auth.uid)
        )
        && getAfter(
          /databases/$(database)/documents/playerCouples/$(request.auth.uid)
        ).data.coupleId == lobbyId;
    }

    // ===============================================================
    // Session and activity validators
    // ===============================================================

    function activityIds() {
      return [
        'comfort-menu', 'small-mercies', 'weather-report', 'receipts',
        'future-artifact', 'postcard-next-year', 'translation', 'map-pin-wish',
        'director-commentary', 'house-rules', 'growth-ring', 'anchor-memory',
        'unsent-draft', 'gratitude-snapshot', 'shared-seed', 'cursed-date-12',
        'yelp-review', 'build-a-cult', 'lore-drop', 'two-truths-one-dream',
        'alternate-job', 'apocalypse-role', 'pet-peeve-love-letter',
        'conspiracy-us', 'wikipedia-us', 'theme-song', 'bad-advice',
        'villain-origin', 'nudge-wars', 'sound-capsule',
        'mind-meld', 'prediction-box', 'the-vault',
        'vibe-check', 'tempo-tap', 'word-weaver',
        'dual-axis-maze', 'blind-canvas', 'harmonic-lock',
        'bluff-bidding', 'photo-flashback',
        'replay-favorite-kiss', 'wanted-list', 'slow-morning',
        'confidence-fit', 'whisper-line', 'scent-memory',
        'favorite-way-held', 'look-you-love', 'flirt-resume',
        'what-miss-today', 'date-that-never-ends', 'secret-admiration',
        'after-hours-tile', 'landing-lights', 'rewind-touch',
        'mutual-yes', 'same-wavelength',
        'rose-thorn-seed', 'ordinary-treasure', 'invisible-backpack',
        'gentle-signal', 'five-minute-tradition', 'museum-of-us',
        'wrong-answers-only', 'couple-mascot', 'tiny-shark-tank',
        'plot-twist', 'soundtrack-shuffle', 'emoji-forecast',
        'closer-than-words', 'date-trailer', 'favorite-detail',
        'green-light-tonight', 'chemistry-recipe', 'doorstep-scene',
      ];
    }

    function miniGameIds() {
      return [
        'mind-meld', 'prediction-box', 'the-vault',
        'vibe-check', 'tempo-tap', 'word-weaver',
        'dual-axis-maze', 'blind-canvas', 'harmonic-lock',
        'bluff-bidding', 'photo-flashback'
      ];
    }

    function isBaseActivityId(activityId) {
      return activityId in activityIds() && !(activityId in miniGameIds());
    }

    function isBoundedInt(value, minValue, maxValue) {
      return value is int
        && value >= minValue
        && value <= maxValue;
    }

    function isPlayerIndex(value) {
      return isBoundedInt(value, 0, 1);
    }

    function isValidImageDataUrl(value, maxSize) {
      return value is string
        && value.size() <= maxSize
        && value.matches('^data:image/(webp|jpeg|png);base64,.{1,}$');
    }

    function isValidActivityStateMinimal(activityId, data) {
      return data is map
        && data.keys().hasAll(['activityId', 'turnIndex'])
        && data.activityId == activityId
        && (
          ('prompt' in data && isBoundedString(data.prompt, 1, 500))
          || ('topic' in data && isBoundedString(data.topic, 1, 200))
        )
        && isPlayerIndex(data.turnIndex)
        && data.keys().size() <= 16
        && (!('imageDataUrl' in data) || data.imageDataUrl == null || isValidImageDataUrl(data.imageDataUrl, 350000));
    }

    function isValidStoredActivityResult(activityId, data) {
      return data is map
        && data.keys().size() <= 11
        && data.payload is map
        && isValidArtifactPayloadBudget(activityId, data.payload)
        && (!('heartBonus' in data) || isBoundedInt(data.heartBonus, 0, 10))
        && (!('title' in data) || isBoundedString(data.title, 1, 160))
        && (!('text' in data) || isBoundedString(data.text, 1, 4000))
        && (!('type' in data) || isBoundedString(data.type, 1, 64));
    }

    function isValidArtifactPayloadBudget(activityId, data) {
      return data is map
        && (
          (isBaseActivityId(activityId) && data.keys().size() <= 6)
          || (activityId in ['mind-meld', 'the-vault', 'harmonic-lock'] && data.keys().size() <= 7)
          || (activityId in ['prediction-box', 'vibe-check', 'tempo-tap', 'word-weaver', 'dual-axis-maze', 'blind-canvas', 'bluff-bidding', 'photo-flashback'] && data.keys().size() <= 8)
        )
        && (!('imageDataUrl' in data) || data.imageDataUrl == null || isValidImageDataUrl(data.imageDataUrl, 350000))
        && (!('entries' in data) || data.entries is list && data.entries.size() <= 2)
        && (!('answers' in data) || data.answers is list && data.answers.size() <= 12)
        && (!('options' in data) || data.options is list && data.options.size() <= 4)
        && (!('results' in data) || data.results is list && data.results.size() == 2)
        && (!('submissions' in data) || data.submissions is list && data.submissions.size() == 2)
        && (!('halves' in data) || data.halves is list && data.halves.size() == 2)
        && (!('history' in data) || data.history is list && data.history.size() <= 8);
    }

    function isValidSkippedActivityResult(data) {
      return data is map
        && data.keys().hasAll(['skipped', 'title'])
        && data.keys().hasOnly(['skipped', 'title'])
        && data.skipped == true
        && isBoundedString(data.title, 1, 160);
    }

    function isValidJournalPayloadBudget(type, data) {
      return data is map
        && (
          (type in ['prompt', 'journal', 'ritual', 'milestone', 'moment-trash', 'moment-treasure'] && data.keys().size() <= 6)
          || (type == 'trophy' && data.keys().size() <= 8)
          || (type in ['match', 'vault', 'harmonic'] && data.keys().size() <= 7)
          || (type in ['prediction', 'vibe-sync', 'tempo', 'word', 'maze', 'canvas', 'bluff', 'photo'] && data.keys().size() <= 8)
          || (type in ['activity-pass', 'duel', 'finale', 'keepsake', 'vibe-setup'] && data.keys().size() <= 40)
        )
        && (!('imageDataUrl' in data) || data.imageDataUrl == null || isValidImageDataUrl(data.imageDataUrl, 750000))
        && (!('entries' in data) || data.entries is list && data.entries.size() <= 2)
        && (!('answers' in data) || data.answers is list && data.answers.size() <= 12)
        && (!('results' in data) || data.results is map || data.results is list)
        && (!('halves' in data) || data.halves is list && data.halves.size() <= 2)
        && (!('history' in data) || data.history is list && data.history.size() <= 8)
        && (!('sharedWords' in data) || data.sharedWords is list && data.sharedWords.size() <= 40)
        && (
          type in [
            'activity-pass', 'bluff', 'canvas', 'duel', 'finale', 'harmonic',
            'journal', 'keepsake', 'match', 'maze', 'photo', 'prediction',
            'prompt', 'ritual', 'tempo', 'vault', 'vibe-setup', 'vibe-sync',
            'word', 'milestone', 'trophy', 'moment-trash', 'moment-treasure'
          ]
        );
    }

    function isValidDuelResult(data) {
      return data is map
        && data.keys().hasAll(['highlight', 'time', 'won'])
        && data.keys().hasOnly([
          'highlight', 'score', 'time', 'won', 'value', 'skipped', 'excerpt',
          'delta', 'dataUrl', 'center', 'spread'
        ])
        && isBoundedString(data.highlight, 1, 240)
        && data.time is number
        && data.time >= 0
        && data.time <= 600
        && data.won is bool
        && (!('score' in data) || (data.score is number && data.score >= 0 && data.score <= 10000))
        && (!('value' in data) || (data.value is number && data.value >= 0 && data.value <= 100))
        && (!('skipped' in data) || data.skipped is bool)
        && isOptionalBoundedString(data, 'excerpt', 100)
        && (!('delta' in data) || (data.delta is number && data.delta >= 0 && data.delta <= 600))
        && isOptionalBoundedString(data, 'dataUrl', 750000)
        && (
          !('center' in data)
          || (
            data.center is map
            && data.center.keys().hasAll(['x', 'y'])
            && data.center.keys().hasOnly(['x', 'y'])
            && data.center.x is number
            && data.center.x >= 0
            && data.center.x <= 4096
            && data.center.y is number
            && data.center.y >= 0
            && data.center.y <= 4096
          )
        )
        && (!('spread' in data) || (data.spread is number && data.spread >= 0 && data.spread <= 4096));
    }

    function hasValidSessionSchema(data) {
      return data.keys().hasAll([
          'actionText', 'activePlayerIndex', 'completedSpotlightActs',
          'coupleId', 'currentDuel', 'duelResults', 'goals', 'hearts',
          'hostId', 'keepsakePerks', 'keepsakes', 'lastDuelOutcome',
          'lastMove', 'lastRoll', 'momentum', 'pendingActivityId',
          'pendingActivityOptions', 'pendingActivityType', 'pendingKeepsake',
          'phase', 'players', 'positions', 'preset', 'round',
          'roundDuelBonus', 'spotlight', 'startingPlayerIndex', 'status',
          'totalRounds', 'turnsTakenThisRound', 'usedActivityIds',
          'usedDuelIds', 'usedKeepsakePerks', 'vibeVotes', 'vibeWeights',
          'moodVotes', 'progressRecorded', 'sealedMatches',
          'mutualYesMatches', 'sharedDuelWins',
          'createdAt', 'startedAt', 'endedAt', 'lastActionAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'actionText', 'activePlayerIndex', 'completedSpotlightActs',
          'coupleId', 'currentDuel', 'duelResults', 'goals', 'hearts',
          'hostId', 'keepsakePerks', 'keepsakes', 'lastDuelOutcome',
          'lastMove', 'lastRoll', 'momentum', 'pendingActivityId',
          'pendingActivityOptions', 'pendingActivityType', 'pendingKeepsake',
          'phase', 'players', 'positions', 'preset', 'round',
          'roundDuelBonus', 'spotlight', 'startingPlayerIndex', 'status',
          'totalRounds', 'turnsTakenThisRound', 'usedActivityIds',
          'usedDuelIds', 'usedKeepsakePerks', 'vibeVotes', 'vibeWeights',
          'pacingVersion', 'moodVotes', 'progressRecorded', 'sealedMatches',
          'kissBookendVersion',
          'mutualYesMatches', 'sharedDuelWins',
          'createdAt', 'startedAt', 'endedAt', 'lastActionAt', 'updatedAt'
        ]);
    }

    function isValidSessionCreate(sessionId) {
      let data = request.resource.data;
      let couple = coupleDataAfter(data.coupleId);
      return hasValidSessionSchema(data)
        && isBoundedString(data.actionText, 1, 500)
        && isBoundedString(data.coupleId, 1, 128)
        && data.players is list
        && data.players.size() == 2
        && data.goals is list
        && data.goals.size() >= 2
        && data.goals.size() <= 3
        && data.duelResults is map
        && data.vibeVotes is map
        && data.vibeVotes.size() == 0
        && data.moodVotes is map
        && data.moodVotes.size() == 0
        && data.progressRecorded is bool
        && data.progressRecorded == false
        && data.sealedMatches is int
        && data.sealedMatches == 0
        && data.mutualYesMatches is int
        && data.mutualYesMatches == 0
        && data.sharedDuelWins is int
        && data.sharedDuelWins == 0
        && (!('kissBookendVersion' in data) || data.kissBookendVersion == 1)
        && data.momentum is map
        && data.spotlight is map
        && data.hearts is int
        && data.totalRounds in [4, 6, 8]
        && isParticipantAfter(data.coupleId)
        && couple.playerIds.size() == 2
        && data.players == couple.players
        && data.hostId == couple.playerIds[0]
        && (!('pacingVersion' in data) || data.pacingVersion == 1)
        && data.preset == couple.sessionPreset
        && (
          (
            data.phase == 'turn'
            && data.vibeWeights is map
            && data.vibeWeights.keys().hasAll(['playful', 'spicy', 'tender'])
            && data.vibeWeights.keys().hasOnly(['playful', 'spicy', 'tender'])
            && data.vibeWeights.playful == 0.3
            && data.vibeWeights.spicy == 0.2
            && data.vibeWeights.tender == 0.5
          )
          || (data.phase == 'vibeSetup' && data.vibeWeights == null)
        )
        && data.status == 'active'
        && data.hearts == 6
        && data.round == 1
        && data.activePlayerIndex in [0, 1]
        && data.startingPlayerIndex == data.activePlayerIndex
        && data.turnsTakenThisRound == 0
        && data.positions == [0, 0]
        && data.currentDuel == null
        && data.pendingActivityId == null
        && data.endedAt == null
        && data.createdAt == request.time
        && data.startedAt == request.time
        && data.lastActionAt == request.time
        && data.updatedAt == request.time
        && couple.activeSessionId == sessionId;
    }

    function isValidSessionTimestamps() {
      return request.resource.data.updatedAt == request.time
        && (
          request.resource.data.lastActionAt == resource.data.lastActionAt
          || request.resource.data.lastActionAt == request.time
        );
    }

    function isValidSessionIdentity() {
      return request.resource.data.get('pacingVersion', 0) == resource.data.get('pacingVersion', 0)
        && request.resource.data.get('kissBookendVersion', 0) == resource.data.get('kissBookendVersion', 0)
        && request.resource.data.coupleId == resource.data.coupleId
        && request.resource.data.players == resource.data.players
        && request.resource.data.preset == resource.data.preset
        && request.resource.data.totalRounds == resource.data.totalRounds
        && request.resource.data.goals == resource.data.goals
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.startedAt == resource.data.startedAt;
    }

    function isValidHostChange() {
      return request.resource.data.hostId == resource.data.hostId
        || (
          hasOnlyChanged(['hostId', 'lastActionAt', 'updatedAt'])
          && request.resource.data.hostId == request.auth.uid
          && request.auth.uid in [
            resource.data.players[0].uid,
            resource.data.players[1].uid
          ]
        );
    }

    function isValidDuelResultSubmission() {
      let playerIds = [
        resource.data.players[0].uid,
        resource.data.players[1].uid
      ];
      let otherIndex = playerIds[0] == request.auth.uid ? 1 : 0;
      return hasOnlyChanged(['duelResults', 'updatedAt'])
        && request.resource.data.phase == 'duel'
        && request.auth.uid in playerIds
        && request.auth.uid in request.resource.data.duelResults
        && isValidDuelResult(
          request.resource.data.duelResults[request.auth.uid]
        )
        && (
          !(playerIds[otherIndex] in resource.data.duelResults)
          || (
            playerIds[otherIndex] in request.resource.data.duelResults
            && request.resource.data.duelResults[playerIds[otherIndex]]
              == resource.data.duelResults[playerIds[otherIndex]]
          )
        );
    }

    function isValidSessionUpdateCompact() {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      return isParticipant(resource.data.coupleId)
        && hasValidSessionSchema(after)
        && isBoundedString(after.actionText, 1, 500)
        && after.status in ['active', 'completed', 'abandoned']
        && (after.endedAt == null || after.endedAt is timestamp)
        && isValidSessionIdentity()
        && isValidSessionTimestamps()
        && isValidHostChange()
        && (
          (
            resource.data.status == 'active'
            && after.status == 'active'
            && after.endedAt == null
          )
          || (
            resource.data.status == 'active'
            && after.status == 'completed'
            && (resource.data.phase == 'duel' || (resource.data.get('pacingVersion', 0) == 1 && resource.data.phase == 'turn'))
            && resource.data.round == resource.data.totalRounds
            && after.phase == 'finale'
            && after.round == resource.data.totalRounds
            && after.currentDuel == null
            && after.endedAt == request.time
          )
          || (
            resource.data.status == 'active'
            && after.status == 'abandoned'
            && after.endedAt == request.time
            && existsAfter(
              /databases/$(database)/documents/couples/$(resource.data.coupleId)
            )
            && getAfter(
              /databases/$(database)/documents/couples/$(resource.data.coupleId)
            ).data.activeSessionId == null
          )
        )
        && (
          changed.hasOnly(['duelResults', 'updatedAt'])
            ? isValidDuelResultSubmission()
            : true
        );
    }

    function isValidIndependentCompletion() {
      let before = resource.data;
      let after = request.resource.data;
      return before.get('pacingVersion', 0) == 1 && before.status == 'active'
        && before.phase == 'turn' && before.round == before.totalRounds
        && after.phase == 'finale' && after.status == 'completed'
        && after.endedAt == request.time && after.lastActionAt == request.time && after.updatedAt == request.time
        && after.diff(before).affectedKeys().hasOnly(['phase', 'status', 'endedAt', 'lastActionAt', 'updatedAt', 'round', 'currentDuel', 'actionText', 'hearts', 'momentum', 'spotlight', 'completedSpotlightActs', 'usedKeepsakePerks', 'sealedMatches', 'mutualYesMatches', 'sharedDuelWins', 'lastDuelOutcome'])
        && after.hearts is int && after.hearts >= 0 && after.hearts <= 1000;
    }

    // Historical sessions created before the spotlight/momentum arc can be
    // terminally detached, but cannot otherwise be edited or modernized.
    function isValidLegacySessionAbandon(sessionId) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return isBoundedString(before.coupleId, 1, 128)
        && isParticipant(before.coupleId)
        && coupleData(before.coupleId).activeSessionId == sessionId
        && changed.hasOnly([
          'status', 'endedAt', 'lastActionAt', 'updatedAt'
        ])
        && before.status == 'active'
        && before.endedAt == null
        && after.status == 'abandoned'
        && after.endedAt == request.time
        && after.lastActionAt == request.time
        && after.updatedAt == request.time
        && existsAfter(
          /databases/$(database)/documents/couples/$(before.coupleId)
        )
        && getAfter(
          /databases/$(database)/documents/couples/$(before.coupleId)
        ).data.activeSessionId == null;
    }

    // Normal active-session writes need a small fast path because an activity
    // completion transaction also writes its activity and scrapbook artifact.
    // The existing lifecycle validator remains the fallback for terminal and
    // legacy transitions, while this path keeps the three-write transaction
    // under Firestore's per-request expression budget.
    function isValidActiveSessionMutationBudget() {
      let after = request.resource.data;
      let changed = after.diff(resource.data).affectedKeys();
      return isParticipant(resource.data.coupleId)
        && after.keys().size() == resource.data.keys().size()
        && after.keys().hasOnly(resource.data.keys())
        && resource.data.status == 'active'
        && after.status == 'active'
        && after.endedAt == null
        && after.coupleId == resource.data.coupleId
        && after.players == resource.data.players
        && after.get('pacingVersion', 0) == resource.data.get('pacingVersion', 0)
        && after.get('kissBookendVersion', 0) == resource.data.get('kissBookendVersion', 0)
        && after.preset == resource.data.preset
        && after.totalRounds == resource.data.totalRounds
        && after.goals == resource.data.goals
        && after.createdAt == resource.data.createdAt
        && after.startedAt == resource.data.startedAt
        && after.actionText is string
        && after.actionText.size() >= 1
        && after.actionText.size() <= 500
        && after.updatedAt == request.time
        && (
          after.lastActionAt == resource.data.lastActionAt
          || after.lastActionAt == request.time
        )
        && (
          changed.hasOnly(['duelResults', 'updatedAt'])
            ? isValidDuelResultSubmission()
            : true
        );
    }

    function isValidActivity(data) {
      return data is map
        && data.keys().hasAll([
          'coupleId', 'sessionId', 'state', 'status', 'type',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'coupleId', 'sessionId', 'state', 'status', 'type',
          'result', 'resolvedAt', 'createdAt', 'updatedAt'
        ])
        && isBoundedString(data.coupleId, 1, 128)
        && isBoundedString(data.sessionId, 1, 128)
        && isValidActivityStateMinimal(data.type, data.state)
        && data.status in ['in_progress', 'completed', 'skipped']
        && data.type in activityIds()
        && (
          !('result' in data)
          || data.result == null
          || isValidSkippedActivityResult(data.result)
          || isValidStoredActivityResult(data.type, data.result)
        )
        && (!('resolvedAt' in data) || data.resolvedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidActivityCreate() {
      let data = request.resource.data;
      return isValidActivity(data)
        && isParticipant(data.coupleId)
        && exists(
          /databases/$(database)/documents/sessions/$(data.sessionId)
        )
        && get(
          /databases/$(database)/documents/sessions/$(data.sessionId)
        ).data.coupleId == data.coupleId
        && get(
          /databases/$(database)/documents/sessions/$(data.sessionId)
        ).data.status == 'active'
        && data.status == 'in_progress'
        && !('result' in data)
        && !('resolvedAt' in data)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidActivityUpdate() {
      return isParticipant(resource.data.coupleId)
        && isValidActivity(request.resource.data)
        && request.resource.data.coupleId == resource.data.coupleId
        && request.resource.data.sessionId == resource.data.sessionId
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && resource.data.status == 'in_progress'
        && (
          (
            request.resource.data.status == 'in_progress'
            && !('resolvedAt' in request.resource.data)
            && hasOnlyChanged(['state', 'updatedAt'])
          )
          || (
            request.resource.data.status in ['completed', 'skipped']
            && request.resource.data.resolvedAt == request.time
            && hasOnlyChanged([
              'state', 'status', 'result', 'resolvedAt', 'updatedAt'
            ])
          )
        );
    }

    function isValidJournalEntry(data) {
      return data is map
        && data.keys().hasAll([
          'coupleId', 'sessionId', 'payload', 'summary',
          'text', 'title', 'type', 'vibe', 'createdAt'
        ])
        && data.keys().hasOnly([
          'coupleId', 'sessionId', 'payload', 'summary',
          'text', 'title', 'type', 'vibe', 'openAt', 'createdAt'
        ])
        && isBoundedString(data.coupleId, 1, 128)
        && isBoundedString(data.sessionId, 1, 128)
        && data.payload is map
        && isValidJournalPayloadBudget(data.type, data.payload)
        && isBoundedString(data.summary, 1, 1200)
        && isBoundedString(data.text, 1, 4000)
        && isBoundedString(data.title, 1, 160)
        && data.type in [
          'activity-pass', 'bluff', 'canvas', 'duel', 'finale', 'harmonic',
          'journal', 'keepsake', 'match', 'maze', 'photo', 'prediction',
          'prompt', 'ritual', 'tempo', 'vault', 'vibe-setup', 'vibe-sync',
          'word', 'milestone', 'trophy', 'moment-trash', 'moment-treasure'
        ]
        && isVibe(data.vibe)
        && isOptionalBoundedString(data, 'openAt', 40)
        && data.createdAt == request.time;
    }

    // Finalizing a long night writes many already-bounded scrapbook records
    // alongside the one authorized active-to-completed session transition.
    // Keep this path compact enough for Firestore's per-request expression
    // budget while preserving the entry envelope and content-size limits.
    function isValidCompletedNightJournalEntry(data) {
      let sessionPath = /databases/$(database)/documents/sessions/$(data.sessionId);
      let before = get(sessionPath).data;
      let after = getAfter(sessionPath).data;
      return data is map
        && data.keys().hasAll([
          'coupleId', 'sessionId', 'payload', 'summary',
          'text', 'title', 'type', 'vibe', 'createdAt'
        ])
        && data.keys().hasOnly([
          'coupleId', 'sessionId', 'payload', 'summary',
          'text', 'title', 'type', 'vibe', 'openAt', 'createdAt'
        ])
        && isBoundedString(data.coupleId, 1, 128)
        && isBoundedString(data.sessionId, 1, 128)
        && before.status == 'active'
        && before.pacingVersion == 1
        && before.coupleId == data.coupleId
        && after.status == 'completed'
        && after.phase == 'finale'
        && after.coupleId == data.coupleId
        && data.payload is map
        && data.payload.keys().size() <= 40
        && (!('imageDataUrl' in data.payload) || data.payload.imageDataUrl == null || isValidImageDataUrl(data.payload.imageDataUrl, 750000))
        && (!('entries' in data.payload) || data.payload.entries is list && data.payload.entries.size() <= 2)
        && (!('answers' in data.payload) || data.payload.answers is list && data.payload.answers.size() <= 12)
        && (!('moments' in data.payload) || data.payload.moments is list && data.payload.moments.size() <= 16)
        && isBoundedString(data.summary, 1, 1200)
        && isBoundedString(data.text, 1, 4000)
        && isBoundedString(data.title, 1, 160)
        && data.type in [
          'activity-pass', 'bluff', 'canvas', 'duel', 'finale', 'harmonic',
          'journal', 'keepsake', 'match', 'maze', 'photo', 'prediction',
          'prompt', 'ritual', 'tempo', 'vault', 'vibe-setup', 'vibe-sync',
          'word', 'milestone', 'trophy', 'moment-trash', 'moment-treasure'
        ]
        && isVibe(data.vibe)
        && isOptionalBoundedString(data, 'openAt', 40)
        && data.createdAt == request.time;
    }

    // ===============================================================
    // Collection rules (default deny outside these matches)
    // ===============================================================

    function mayReadLock(key) {
      let email = request.auth.token.get('email', '');
      let link = /databases/$(database)/documents/playerCouples/$(request.auth.uid);
      return request.auth.token.get('email_verified', false) && (key == emailLockKey(email)
        || (exists(link) && isParticipant(get(link).data.coupleId)
          && (key == emailLockKey(coupleData(get(link).data.coupleId).get('commitmentEmails', {}).get(coupleData(get(link).data.coupleId).playerIds[0], ''))
            || key == emailLockKey(coupleData(get(link).data.coupleId).get('commitmentEmails', {}).get(coupleData(get(link).data.coupleId).playerIds[1], '')))));
    }

    // Email invitations are visible only to their sender and verified addressee.
    function isEmailRecipient(data) {
      return isAuthenticated() && request.auth.token.get('email_verified', false)
        && data.recipientEmail == request.auth.token.get('email', '').lower();
    }
    function isValidEmailInvitation(data) {
      return data.keys().hasAll(['senderId', 'senderEmail', 'senderName', 'senderAvatar', 'recipientEmail', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['senderId', 'senderEmail', 'senderName', 'senderAvatar', 'recipientEmail', 'status', 'createdAt', 'updatedAt'])
        && isBoundedString(data.senderId, 1, 128) && isBoundedString(data.senderName, 1, 60)
        && isBoundedString(data.senderAvatar, 1, 160)
        && isBoundedString(data.senderEmail, 3, 254) && isBoundedString(data.recipientEmail, 3, 254)
        && data.recipientEmail == data.recipientEmail.lower()
        && data.recipientEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && data.senderEmail != data.recipientEmail && data.status in ['pending', 'declined']
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /emailInvitations/{coupleId} {
      allow get: if isAuthenticated() && ((resource == null && isParticipant(coupleId))
        || (resource != null && (resource.data.senderId == request.auth.uid || isEmailRecipient(resource.data))));
      allow list: if isEmailRecipient(resource.data);
      allow create: if isAuthenticated() && request.auth.token.get('email_verified', false)
        && isValidEmailInvitation(request.resource.data)
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.get('email', '').lower()
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && coupleDataAfter(coupleId).status == 'waiting'
        && coupleDataAfter(coupleId).playerIds == [request.auth.uid]
        && request.resource.data.senderName == coupleDataAfter(coupleId).players[0].displayName
        && request.resource.data.senderAvatar == coupleDataAfter(coupleId).players[0].avatar
        && !existsAfter(/databases/$(database)/documents/coupleInvites/$(coupleDataAfter(coupleId).inviteCode));
      allow update: if isEmailRecipient(resource.data) && resource.data.status == 'pending'
        && isValidEmailInvitation(request.resource.data)
        && hasOnlyChanged(['status', 'updatedAt']) && request.resource.data.status == 'declined';
      allow delete: if isAuthenticated() && (
        (resource.data.senderId == request.auth.uid && coupleDataAfter(coupleId).status == 'unpaired')
        || (isEmailRecipient(resource.data) && resource.data.status == 'pending'
          && coupleDataAfter(coupleId).status == 'paired'
          && coupleDataAfter(coupleId).playerIds == [resource.data.senderId, request.auth.uid]));
    }

    match /pairingLocks/{key} {
      allow get: if isAuthenticated() && mayReadLock(key);
      allow list: if false;
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['coupleId', 'uid', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['coupleId', 'uid', 'email', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && key == emailLockKey(request.resource.data.email)
        && isParticipantAfter(request.resource.data.coupleId)
        && isPermanentPair(coupleDataAfter(request.resource.data.coupleId))
        && coupleDataAfter(request.resource.data.coupleId).commitmentEmails[request.resource.data.uid] == request.resource.data.email
        && request.auth.token.get('email_verified', false);
      allow update, delete: if false;
    }

    match /pairingMoments/{momentId} {
      allow get: if isAuthenticated() && ((resource != null && isParticipant(resource.data.coupleId))
        || (resource == null && exists(/databases/$(database)/documents/playerCouples/$(request.auth.uid))
          && momentId.matches('^' + get(/databases/$(database)/documents/playerCouples/$(request.auth.uid)).data.coupleId + '_(connected|committed|night_(1|10|25|50|100))$')));
      allow list: if isParticipant(resource.data.coupleId);
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['coupleId', 'kind', 'nights', 'names', 'avatars', 'createdAt'])
        && request.resource.data.keys().hasOnly(['coupleId', 'kind', 'nights', 'names', 'avatars', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && isParticipantAfter(request.resource.data.coupleId)
        && request.resource.data.names == [coupleDataAfter(request.resource.data.coupleId).players[0].displayName, coupleDataAfter(request.resource.data.coupleId).players[1].displayName]
        && request.resource.data.avatars == [coupleDataAfter(request.resource.data.coupleId).players[0].avatar, coupleDataAfter(request.resource.data.coupleId).players[1].avatar]
        && ((request.resource.data.kind == 'connected' && request.resource.data.nights == 0
            && momentId == request.resource.data.coupleId + '_connected'
            && coupleData(request.resource.data.coupleId).status == 'waiting'
            && coupleDataAfter(request.resource.data.coupleId).status == 'paired')
          || (request.resource.data.kind == 'committed' && request.resource.data.nights == 0
            && momentId == request.resource.data.coupleId + '_committed'
            && isPermanentPair(coupleDataAfter(request.resource.data.coupleId)))
          || (request.resource.data.kind == 'night'
            && request.resource.data.nights in [1, 10, 25, 50, 100]
            && momentId == request.resource.data.coupleId + '_night_' + string(request.resource.data.nights)
            && getAfter(/databases/$(database)/documents/coupleProgress/$(request.resource.data.coupleId)).data.lifetimeNights == request.resource.data.nights));
      allow update, delete: if false;
    }

    match /profiles/{userId}/celebrationReceipts/{momentId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt == request.time;
      allow delete: if false;
    }

    function portraitFrameCost(frame) {
      return {'ribbon': 0, 'ivory': 0, 'midnight': 0, 'starlight': 24, 'rose': 48, 'laurel': 80}.get(frame, -1);
    }
    match /couplePortraits/{coupleId}/players/{userId} {
      function validPortrait(data) {
        return data.keys().hasAll(['photoURL', 'selectedFrame', 'ownedFrames', 'updatedAt'])
          && data.keys().hasOnly(['photoURL', 'selectedFrame', 'ownedFrames', 'updatedAt', 'pieceColor', 'pieceMaterial'])
          && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1800
            && data.photoURL.matches('^https://([a-zA-Z0-9-]+[.])?googleusercontent[.]com/.+$')))
          && data.ownedFrames is list && data.ownedFrames.size() <= 6
          && data.ownedFrames.toSet().size() == data.ownedFrames.size()
          && data.ownedFrames.hasAll(['ribbon', 'ivory', 'midnight'])
          && data.ownedFrames.hasOnly(['ribbon', 'ivory', 'midnight', 'starlight', 'rose', 'laurel'])
          && data.selectedFrame in data.ownedFrames
          && (!('pieceColor' in data) || isValidColor(data.pieceColor))
          && (!('pieceMaterial' in data) || data.pieceMaterial in ['porcelain', 'satin', 'gold', 'velvet'])
          && data.updatedAt == request.time;
      }
      function paidForFrame() {
        let before = resource.data.ownedFrames;
        let after = request.resource.data;
        let oldProgress = get(/databases/$(database)/documents/coupleProgress/$(coupleId)).data;
        let nextProgress = getAfter(/databases/$(database)/documents/coupleProgress/$(coupleId)).data;
        return after.ownedFrames.size() == before.size() + 1
          && after.ownedFrames.hasAll(before)
          && after.ownedFrames.hasOnly(before.concat([after.selectedFrame]))
          && !(after.selectedFrame in before) && portraitFrameCost(after.selectedFrame) > 0
          && nextProgress.heartsSpent == oldProgress.heartsSpent + portraitFrameCost(after.selectedFrame)
          && nextProgress.diff(oldProgress).affectedKeys().hasOnly(['heartsSpent', 'updatedAt']);
      }
      allow read: if isParticipant(coupleId);
      allow create: if isOwner(userId) && isActiveParticipant(coupleId) && validPortrait(request.resource.data)
        && request.resource.data.ownedFrames == ['ribbon', 'ivory', 'midnight'];
      allow update: if isOwner(userId) && isActiveParticipant(coupleId) && validPortrait(request.resource.data)
        && (request.resource.data.ownedFrames == resource.data.ownedFrames || paidForFrame());
      allow delete: if false;
    }

    match /coupleArcades/{coupleId}/games/{gameId} {
      function validCharadeClip(clips, uid) {
        return !clips.keys().hasAny([uid])
          || (clips[uid] is string && clips[uid].size() <= 260000
            && clips[uid].matches('^data:video/(webm|mp4).*'));
      }
      function validArcadeState(data, allowedPlayers) {
        let state = data.state;
        return data.gameId == gameId
          && gameId in ['my-one-and-only', 'catch-my-heart', 'radar-love', 'say-it-without-saying']
          && data.playerUids == allowedPlayers
          && data.playerUids is list && data.playerUids.size() == 2
          && state is map && state.playerUids == allowedPlayers
          && state.status in ['playing', 'finished']
          && (
            (gameId == 'my-one-and-only'
              && state.keys().hasAll(['game', 'playerUids', 'hands', 'drawPile', 'discardPile', 'activeColor', 'turnIndex', 'status', 'winnerUid', 'drawnCardId', 'moveCount'])
              && state.keys().hasOnly(['game', 'playerUids', 'hands', 'drawPile', 'discardPile', 'activeColor', 'turnIndex', 'status', 'winnerUid', 'drawnCardId', 'moveCount'])
              && state.game == gameId && state.hands is map
              && state.hands.keys().hasAll(allowedPlayers) && state.hands.keys().hasOnly(allowedPlayers)
              && state.hands[allowedPlayers[0]] is list && state.hands[allowedPlayers[0]].size() <= 108
              && state.hands[allowedPlayers[1]] is list && state.hands[allowedPlayers[1]].size() <= 108
              && state.drawPile is list && state.drawPile.size() <= 108
              && state.discardPile is list && state.discardPile.size() <= 108
              && state.activeColor in ['coral', 'plum', 'teal', 'gold']
              && state.turnIndex in [0, 1]
              && (state.winnerUid == null || state.winnerUid in allowedPlayers)
              && isBoundedInt(state.moveCount, 0, 10000))
            ||
            (gameId == 'catch-my-heart'
              && state.keys().hasAll(['game', 'playerUids', 'hands', 'drawPile', 'books', 'turnIndex', 'status', 'winnerUid', 'lastAction'])
              && state.keys().hasOnly(['game', 'playerUids', 'hands', 'drawPile', 'books', 'turnIndex', 'status', 'winnerUid', 'lastAction'])
              && state.game == gameId && state.hands is map
              && state.hands.keys().hasAll(allowedPlayers) && state.hands.keys().hasOnly(allowedPlayers)
              && state.hands[allowedPlayers[0]] is list && state.hands[allowedPlayers[0]].size() <= 52
              && state.hands[allowedPlayers[1]] is list && state.hands[allowedPlayers[1]].size() <= 52
              && state.drawPile is list && state.drawPile.size() <= 52
              && state.books is map && state.books.keys().hasAll(allowedPlayers) && state.books.keys().hasOnly(allowedPlayers)
              && state.books[allowedPlayers[0]] is list && state.books[allowedPlayers[0]].size() <= 13
              && state.books[allowedPlayers[1]] is list && state.books[allowedPlayers[1]].size() <= 13
              && state.turnIndex in [0, 1]
              && (state.winnerUid == null || state.winnerUid in allowedPlayers))
            ||
            (gameId == 'radar-love'
              && state.keys().hasAll(['game', 'playerUids', 'fleets', 'shots', 'hits', 'turnIndex', 'status', 'winnerUid', 'lastShot', 'boardSize'])
              && state.keys().hasOnly(['game', 'playerUids', 'fleets', 'shots', 'hits', 'turnIndex', 'status', 'winnerUid', 'lastShot', 'boardSize'])
              && state.game == gameId && state.fleets is map
              && state.fleets.keys().hasAll(allowedPlayers) && state.fleets.keys().hasOnly(allowedPlayers)
              && state.fleets[allowedPlayers[0]] is list && state.fleets[allowedPlayers[0]].size() == 3
              && state.fleets[allowedPlayers[1]] is list && state.fleets[allowedPlayers[1]].size() == 3
              && state.shots is map && state.shots.keys().hasAll(allowedPlayers) && state.shots.keys().hasOnly(allowedPlayers)
              && state.shots[allowedPlayers[0]] is list && state.shots[allowedPlayers[0]].size() <= 64
              && state.shots[allowedPlayers[1]] is list && state.shots[allowedPlayers[1]].size() <= 64
              && state.hits is map && state.hits.keys().hasAll(allowedPlayers) && state.hits.keys().hasOnly(allowedPlayers)
              && state.hits[allowedPlayers[0]] is list && state.hits[allowedPlayers[0]].size() <= 14
              && state.hits[allowedPlayers[1]] is list && state.hits[allowedPlayers[1]].size() <= 14
              && state.turnIndex in [0, 1] && state.boardSize == 8
              && (state.winnerUid == null || state.winnerUid in allowedPlayers))
            ||
            (gameId == 'say-it-without-saying'
              && state.keys().hasAll(['game', 'playerUids', 'actorIndex', 'phase', 'promptIndex', 'clips', 'guesses', 'scores', 'status', 'winnerUid'])
              && state.keys().hasOnly(['game', 'playerUids', 'actorIndex', 'phase', 'promptIndex', 'clips', 'guesses', 'scores', 'status', 'winnerUid'])
              && state.game == gameId && state.actorIndex in [0, 1]
              && state.phase in ['act', 'guess'] && isBoundedInt(state.promptIndex, 0, 15)
              && state.clips is map && state.clips.size() <= 2 && state.clips.keys().hasOnly(allowedPlayers)
              && validCharadeClip(state.clips, allowedPlayers[0])
              && validCharadeClip(state.clips, allowedPlayers[1])
              && state.guesses is map && state.guesses.size() <= 2 && state.guesses.keys().hasOnly(allowedPlayers)
              && state.scores is list && state.scores.size() == 2
              && isBoundedInt(state.scores[0], 0, 2) && isBoundedInt(state.scores[1], 0, 2)
              && (state.winnerUid == null || state.winnerUid in allowedPlayers))
          );
      }
      function validArcadeRecord(data) {
        let allowedPlayers = coupleData(coupleId).playerIds;
        return data is map
          && data.keys().hasAll(['gameId', 'playerUids', 'state', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['gameId', 'playerUids', 'state', 'createdAt', 'updatedAt'])
          && data.createdAt is timestamp && data.updatedAt == request.time
          && validArcadeState(data, allowedPlayers);
      }
      allow read: if isActiveParticipant(coupleId);
      allow create: if isActiveParticipant(coupleId) && validArcadeRecord(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isActiveParticipant(coupleId) && validArcadeRecord(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /profiles/{userId} {
      function isValidProfile(data) {
        return data.keys().hasAll([
            'displayName', 'email', 'isAnonymous',
            'createdAt', 'lastSeenAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'displayName', 'email', 'isAnonymous',
            'createdAt', 'lastSeenAt', 'updatedAt', 'loginStreak'
          ])
          && (!('loginStreak' in data) || (
            data.loginStreak is map
            && data.loginStreak.keys().hasAll(['lastDate', 'dayCount', 'weekCount', 'bestDayCount'])
            && data.loginStreak.keys().hasOnly(['lastDate', 'dayCount', 'weekCount', 'bestDayCount'])
            && data.loginStreak.lastDate is string
            && data.loginStreak.lastDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && isBoundedInt(data.loginStreak.dayCount, 1, 100000)
            && isBoundedInt(data.loginStreak.weekCount, 1, 100000)
            && isBoundedInt(data.loginStreak.bestDayCount, 1, 100000)
          ))
          && isBoundedString(data.displayName, 1, 60)
          && (
            data.email == null
            || (
              data.email is string
              && data.email.size() <= 254
              && data.email == request.auth.token.email
            )
          )
          && data.isAnonymous is bool
          && data.createdAt is timestamp
          && data.lastSeenAt is timestamp
          && data.updatedAt is timestamp;
      }

      allow create: if isOwner(userId)
        && uidUnchanged(userId)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow read: if isOwner(userId);

      allow update: if isOwner(userId)
        && uidNotModified(userId)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /coupleInvites/{inviteCode} {
      allow create: if isAuthenticated()
        && isValidInvite(request.resource.data, inviteCode)
        && coupleExistsAfter(request.resource.data.coupleId)
        && coupleDataAfter(request.resource.data.coupleId).inviteCode == inviteCode
        && coupleDataAfter(request.resource.data.coupleId).playerIds[0]
          == request.auth.uid;

      allow get: if isAuthenticated();
      allow list: if false;
      allow update: if isAuthenticated()
        && coupleData(resource.data.coupleId).playerIds[0] == request.auth.uid
        && coupleData(resource.data.coupleId).status == 'waiting'
        && hasOnlyChanged(['hostId']) && request.resource.data.hostId == request.auth.uid;

      allow delete: if isAuthenticated() && isParticipantAfter(resource.data.coupleId);
    }

    match /playerCouples/{userId} {
      allow create, update: if isOwner(userId)
        && uidUnchanged(userId)
        && isValidPlayerCoupleLink(request.resource.data)
        && isParticipantAfter(request.resource.data.coupleId)
        && coupleDataAfter(request.resource.data.coupleId).status != 'unpaired'
        && (canConnect() || (resource != null && resource.data.coupleId == request.resource.data.coupleId));

      allow read: if isOwner(userId);
      allow delete: if isOwner(userId) && (!coupleExists(resource.data.coupleId)
        || !isPermanentPair(coupleData(resource.data.coupleId)));
    }

    match /couples/{coupleId} {
      allow create: if isAuthenticated()
        && isValidCoupleCreate(coupleId);

      allow read: if isCoupleParticipantData(resource.data);

      allow update: if isAuthenticated()
        && resource.data.status != 'unpaired'
        && isPairingUpdate(coupleId)
        && (!isPermanentPair(resource.data) || request.resource.data.playerIds == resource.data.playerIds);

      allow delete: if isAuthenticated()
        && !isPermanentPair(resource.data) && isValidLastParticipantDelete(coupleId);
    }

    match /publicLobbies/{lobbyId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidPublicLobby(request.resource.data, lobbyId)
        && coupleExistsAfter(lobbyId)
        && lobbyMatchesCouple(request.resource.data, coupleDataAfter(lobbyId))
        && (
          request.resource.data.hostId == request.auth.uid
          || (
            coupleExists(lobbyId)
            && isCoupleParticipantData(coupleData(lobbyId))
          )
        );

      allow update: if isAuthenticated()
        && isValidPublicLobby(request.resource.data, lobbyId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.hostId == request.auth.uid
        && coupleExistsAfter(lobbyId)
        && lobbyMatchesCouple(request.resource.data, coupleDataAfter(lobbyId));

      allow delete: if isAuthenticated()
        && (
          (
            isParticipant(resource.data.coupleId)
            && hasNoActiveSession(coupleData(resource.data.coupleId))
          )
          || isCompletedLobbyJoin(lobbyId)
        );
    }

    match /coupleProgress/{coupleId} {
      function isDateString(value) {
        return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      function isValidKoupon(data) {
        return data is map
          && data.keys().hasAll(['id', 'label', 'status', 'createdAt'])
          && data.keys().hasOnly([
            'id', 'label', 'detail', 'status',
            'createdAt', 'redeemedAt', 'fulfilledAt'
          ])
          && isBoundedString(data.id, 1, 64)
          && isBoundedString(data.label, 1, 80)
          && isOptionalBoundedString(data, 'detail', 200)
          && data.status in ['active', 'redeemed', 'fulfilled']
          && data.createdAt is timestamp
          && (
            !('redeemedAt' in data)
            || data.redeemedAt == null
            || data.redeemedAt is timestamp
          )
          && (
            !('fulfilledAt' in data)
            || data.fulfilledAt == null
            || data.fulfilledAt is timestamp
          );
      }

      function isValidCompanion(data) {
        return data is map
          && data.keys().hasAll(['name', 'stage', 'heartsFed'])
          && data.keys().hasOnly(['name', 'stage', 'heartsFed'])
          && isBoundedString(data.name, 1, 40)
          && isBoundedInt(data.stage, 0, 3)
          && data.heartsFed is int
          && data.heartsFed >= 0
          && data.heartsFed <= 1000000;
      }

      function isValidFlower(data) {
        return data is map
          && data.keys().hasAll(['growth', 'stage', 'wateredBy', 'wateredDate'])
          && data.keys().hasOnly(['growth', 'stage', 'wateredBy', 'wateredDate', 'speciesIndex', 'collected'])
          && data.growth is int
          && data.growth >= 0
          && data.growth <= 1000000
          && isBoundedInt(data.stage, 0, 3)
          && data.wateredBy is list
          && data.wateredBy.size() <= 2
          && data.wateredBy.hasOnly(
            get(/databases/$(database)/documents/couples/$(coupleId)).data.playerIds
          )
          && (data.wateredBy.size() < 2 || data.wateredBy[0] != data.wateredBy[1])
          && (
            (!('speciesIndex' in data) && !('collected' in data))
            || (
              isBoundedInt(data.speciesIndex, 0, 5)
              && data.growth <= 6
              && (
                (data.growth == 0 && data.stage == 0)
                || (data.growth >= 1 && data.growth <= 2 && data.stage == 1)
                || (data.growth >= 3 && data.growth <= 5 && data.stage == 2)
                || (data.growth == 6 && data.stage == 3)
              )
              && data.collected is list
              && data.collected.size() == data.speciesIndex
              && data.collected.hasOnly(['daisy', 'tulip', 'sunflower', 'rose', 'cosmos'])
              && (data.collected.size() < 1 || data.collected[0] == 'daisy')
              && (data.collected.size() < 2 || data.collected[1] == 'tulip')
              && (data.collected.size() < 3 || data.collected[2] == 'sunflower')
              && (data.collected.size() < 4 || data.collected[3] == 'rose')
              && (data.collected.size() < 5 || data.collected[4] == 'cosmos')
            )
          )
          && (data.wateredDate == null || isDateString(data.wateredDate));
      }

      function isValidNudge(data) {
        return data is map
          && data.keys().hasAll(['byUid', 'byName', 'at'])
          && data.keys().hasOnly(['byUid', 'byName', 'at'])
          && isBoundedString(data.byUid, 1, 128)
          && isBoundedString(data.byName, 1, 60)
          && data.at is timestamp;
      }

      function isValidConnectFourTokenPreference(tokenId, lifetimeNights) {
        return tokenId == 'garnet' || tokenId == 'moon' || tokenId == 'strawberry' || tokenId == 'chicken'
          || (tokenId == 'leaf' && lifetimeNights >= 3)
          || (tokenId == 'key' && lifetimeNights >= 7)
          || (tokenId == 'shell' && lifetimeNights >= 14)
          || (tokenId == 'lantern' && lifetimeNights >= 25)
          || (tokenId == 'letter' && lifetimeNights >= 40)
          || (tokenId == 'blossom' && lifetimeNights >= 60)
          || (tokenId == 'compass' && lifetimeNights >= 100)
          || (tokenId == 'candle' && lifetimeNights >= 125)
          || (tokenId == 'teacup' && lifetimeNights >= 150)
          || (tokenId == 'cottage' && lifetimeNights >= 175)
          || (tokenId == 'paintbox' && lifetimeNights >= 200)
          || (tokenId == 'hourglass' && lifetimeNights >= 225)
          || (tokenId == 'umbrella' && lifetimeNights >= 250)
          || (tokenId == 'picnic' && lifetimeNights >= 275)
          || (tokenId == 'musicbox' && lifetimeNights >= 300)
          || (tokenId == 'sunrise' && lifetimeNights >= 365)
          || (tokenId == 'beehive' && lifetimeNights >= 400)
          || (tokenId == 'cherries' && lifetimeNights >= 425)
          || (tokenId == 'fern' && lifetimeNights >= 450)
          || (tokenId == 'moonwindow' && lifetimeNights >= 475)
          || (tokenId == 'apple' && lifetimeNights >= 500)
          || (tokenId == 'ribbonbow' && lifetimeNights >= 525)
          || (tokenId == 'gardenlantern' && lifetimeNights >= 550);
      }

      function isValidConnectFourTokenPreferences(data, lifetimeNights) {
        let players = get(/databases/$(database)/documents/couples/$(coupleId)).data.playerIds;
        let preferences = data.connectFourTokenPreferences;
        return !('connectFourTokenPreferences' in data) || (
          preferences is map
          && players is list
          && (players.size() == 0 || players.size() == 2)
          && preferences.size() <= 2
          && preferences.keys().hasOnly(players)
          && (players.size() < 1 || !(players[0] in preferences) || isValidConnectFourTokenPreference(preferences[players[0]], lifetimeNights))
          && (players.size() < 2 || !(players[1] in preferences) || isValidConnectFourTokenPreference(preferences[players[1]], lifetimeNights))
          && (players.size() != 2 || ((players[0] in preferences ? preferences[players[0]] : 'garnet') != (players[1] in preferences ? preferences[players[1]] : 'moon')))
        );
      }

      function isValidProgress(data) {
        return data is map
          && data.keys().hasAll([
            'coupleId', 'lifetimeHearts', 'heartsSpent', 'lifetimeNights',
            'unlockedThemes', 'streakCount', 'streakLastDate', 'freezeTokens',
            'trophies', 'koupons', 'companion', 'anniversary',
            'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'coupleId', 'lifetimeHearts', 'heartsSpent', 'lifetimeNights',
            'unlockedThemes', 'streakCount', 'streakLastDate', 'freezeTokens',
            'trophies', 'koupons', 'companion', 'flower', 'anniversary', 'nudge',
            'selectedTheme', 'lastBankedSessionId', 'connectFour', 'connectFourTokenPreferences',
            'createdAt', 'updatedAt'
          ])
          && data.coupleId == coupleId
          && data.lifetimeHearts is int
          && data.lifetimeHearts >= 0
          && data.lifetimeHearts <= 1000000
          && (data.lastBankedSessionId == null || isBoundedString(data.lastBankedSessionId, 1, 128))
          && data.heartsSpent is int
          && data.heartsSpent >= 0
          && data.heartsSpent <= data.lifetimeHearts
          && data.lifetimeNights is int
          && data.lifetimeNights >= 0
          && data.lifetimeNights <= 1000000
          && data.unlockedThemes is list
          && data.unlockedThemes.size() <= 12
          && data.streakCount is int
          && data.streakCount >= 0
          && data.streakCount <= 1000000
          && (data.streakLastDate == null || isDateString(data.streakLastDate))
          && isBoundedInt(data.freezeTokens, 0, 5)
          && data.trophies is list
          && data.trophies.size() <= 24
          && data.koupons is list
          && data.koupons.size() <= 20
          && isValidCompanion(data.companion)
          && isValidConnectFourTokenPreferences(data, data.lifetimeNights)
          && (data.anniversary == null || isDateString(data.anniversary))
          && (
            !('selectedTheme' in data)
            || isBoundedString(data.selectedTheme, 1, 40)
          )
          && (
            !('nudge' in data)
            || data.nudge == null
            || isValidNudge(data.nudge)
          )
          && (
            !('flower' in data)
            || isValidFlower(data.flower)
          )
          && data.createdAt is timestamp
          && data.updatedAt == request.time;
      }

      allow create: if isAuthenticated()
        && isActiveParticipant(coupleId)
        && isValidProgress(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow read: if isParticipant(coupleId);

      allow update: if isAuthenticated()
        && isActiveParticipant(coupleId)
        && isValidProgress(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if false;
    }

    match /lobbyMessages/{messageId} {
      function isValidLobbyMessage(data) {
        return data.keys().hasAll([
            'lobbyId', 'authorId', 'authorName', 'text', 'createdAt'
          ])
          && data.keys().hasOnly([
            'lobbyId', 'authorId', 'authorName', 'text', 'createdAt'
          ])
          && isBoundedString(data.lobbyId, 1, 128)
          && data.authorId == request.auth.uid
          && isBoundedString(data.authorName, 1, 60)
          && isBoundedString(data.text, 1, 280)
          && data.createdAt == request.time;
      }

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && isValidLobbyMessage(request.resource.data)
        && exists(
          /databases/$(database)/documents/publicLobbies/$(request.resource.data.lobbyId)
        );

      allow update, delete: if false;
    }

    match /sessions/{sessionId} {
      allow create: if isAuthenticated()
        && isActiveParticipant(request.resource.data.coupleId) && isValidSessionCreate(sessionId);

      allow read: if isParticipant(resource.data.coupleId);

      allow update: if isAuthenticated()
        && isActiveParticipant(resource.data.coupleId)
        && (request.resource.data.status == 'abandoned'
          ? (isValidLegacySessionAbandon(sessionId) || isValidSessionUpdateCompact())
          : (isValidIndependentCompletion() || isValidActiveSessionMutationBudget() || isValidSessionUpdateCompact()));

      allow delete: if false;
    }


    // Bounded independent-night slots. Parent membership gates even missing
    // slots so both phones can transactionally read the same round schedule.
    match /sessions/{sessionId}/steps/{stepId} {
      function night() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }
      function validPortraitCue(cue) {
        return cue in ['left', 'right', 'larger', 'smaller', 'closer', 'one-detail', 'simple', 'smile'];
      }
      function validPortraitGuide(cues) {
        return cues is list && cues.size() == 3
          && validPortraitCue(cues[0]) && validPortraitCue(cues[1]) && validPortraitCue(cues[2])
          && cues[0] != cues[1] && cues[0] != cues[2] && cues[1] != cues[2];
      }
      function validPortraitGuides(data) {
        let guides = data.state.get('guides', {});
        return data.type != 'portrait-panic-directed'
          || (guides is map && guides.keys().hasOnly(['0', '1'])
            && (!guides.keys().hasAny(['0']) || validPortraitGuide(guides['0']))
            && (!guides.keys().hasAny(['1']) || validPortraitGuide(guides['1'])));
      }
      function validStep(data) {
        return data.keys().hasAll(['kind', 'type', 'round', 'ownerIndex', 'state', 'ready', 'completed', 'skipped', 'updatedAt'])
          && data.keys().hasOnly(['kind', 'type', 'round', 'ownerIndex', 'state', 'ready', 'completed', 'skipped', 'updatedAt'])
          && data.kind in ['activity', 'duel', 'keepsake', 'board']
          && isBoundedString(data.type, 1, 100)
          && data.round is int && data.round >= 1 && data.round <= night().totalRounds
          && data.ownerIndex in [-1, 0, 1]
          && data.state is map && data.state.keys().size() <= 25
          && validPortraitGuides(data)
          && data.ready is bool && data.completed is bool && data.skipped is bool
          && data.updatedAt == request.time;
      }
      function ownMapOnly(key, mine) {
        return request.resource.data.state.get(key, {}).diff(resource.data.state.get(key, {})).affectedKeys().hasOnly([mine]);
      }
      function ownListOnly(key, mine) {
        let before = resource.data.state.get(key, []);
        let after = request.resource.data.state.get(key, []);
        return after == before || (after.size() == before.size() + 1
          && after.hasAll(before) && after[after.size() - 1].playerIndex == mine);
      }
      function preservesPartnerInput() {
        let index = night().players[0].uid == request.auth.uid ? 0 : 1;
        let mine = string(index);
        let keys = resource.data.state.keys();
        return resource.data.kind == 'duel' ? (resource.data.type == 'portrait-panic-directed'
          ? (ownMapOnly('guides', mine) && ownMapOnly('results', mine)
            && (!resource.data.state.get('guides', {}).keys().hasAny([mine])
              || request.resource.data.state.get('guides', {})[mine] == resource.data.state.get('guides', {})[mine]))
          : ownMapOnly('results', mine))
          : keys.hasAny(['entries']) ? ownListOnly('entries', index)
          : keys.hasAny(['halves']) ? ownListOnly('halves', index)
          : keys.hasAny(['commitments']) ? (ownMapOnly('commitments', mine) && ownMapOnly('answers', mine))
          : keys.hasAny(['sealed']) ? (ownMapOnly('sealed', mine) && ownMapOnly('salts', mine))
          : keys.hasAny(['answers']) ? ownMapOnly('answers', mine)
          : keys.hasAny(['values']) ? ownMapOnly('values', mine)
          : keys.hasAny(['results']) ? ownMapOnly('results', mine)
          : keys.hasAny(['submissions']) ? ownMapOnly('submissions', mine)
          : keys.hasAny(['captions']) ? ownMapOnly('captions', mine) : true;
      }
      allow read: if isAuthenticated() && request.auth.uid in [night().players[0].uid, night().players[1].uid];
      allow create: if isActiveParticipant(night().coupleId)
        && night().get('pacingVersion', 0) == 1 && night().status == 'active'
        && validStep(request.resource.data)
        && (request.resource.data.kind == 'duel'
          ? (request.resource.data.ownerIndex == -1 && stepId == 'duel-' + string(request.resource.data.round) && request.resource.data.type in ['constellation-home', 'heartbeat-hold-tender', 'letterpress-one-word', 'sync-breath', 'gratitude-duel', 'doodle-duel-memory', 'portrait-panic-directed', 'wavelength-slider', 'emoji-court', 'reaction-heart', 'kiss-courier', 'fever-dream-date', 'voice-note-trailer', 'temperature-check', 'slow-draw-portrait-romantic', 'wavelength-duel', 'love-in-the-blanks', 'our-next-line'])
          : (request.resource.data.ownerIndex in [0, 1]
            && night().players[request.resource.data.ownerIndex].uid == request.auth.uid
            && stepId == 'roll-' + string(request.resource.data.round) + '-' + string(request.resource.data.ownerIndex)))
        && (request.resource.data.kind != 'activity' || request.resource.data.type in activityIds());
      allow update: if isActiveParticipant(night().coupleId)
        && night().status == 'active' && validStep(request.resource.data)
        && preservesPartnerInput()
        && (resource.data.kind != 'keepsake' && resource.data.kind != 'board' || night().players[resource.data.ownerIndex].uid == request.auth.uid)
        && (!resource.data.completed || (resource.data.kind == 'board'
          && !resource.data.state.keys().hasAny(['momentResolution'])
          && (resource.data.state.keys().hasAny(['momentCard'])
            || (resource.data.state.get('momentPending', false) == true
              && request.resource.data.state.get('momentPending', true) == false
              && request.resource.data.state.keys().hasAll(['coinResult', 'momentCard'])
              && request.resource.data.state.coinResult in ['trash', 'treasure']))))
        && !resource.data.skipped
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'ready', 'completed', 'skipped', 'updatedAt']);
      allow delete: if false;
    }

    // Each participant sends one short microphone note at the start of a
    // night. Only that sender can create the recording; the other participant
    // can mark that specific recording caught, without changing its audio.
    match /sessions/{sessionId}/nightKisses/{senderId} {
      function night() {
        return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
      }
      function isNightParticipant() {
        return isAuthenticated()
          && request.auth.uid in [night().players[0].uid, night().players[1].uid];
      }
      function validNightKiss(data) {
        return data is map
          && data.keys().hasAll(['audioData', 'mimeType', 'durationMs', 'caughtBy', 'sentAt', 'updatedAt'])
          && data.keys().hasOnly(['audioData', 'mimeType', 'durationMs', 'caughtBy', 'sentAt', 'updatedAt'])
          && data.audioData is string
          && data.audioData.size() >= 1 && data.audioData.size() <= 300000
          && data.audioData.matches('^data:audio/(webm|mp4|ogg)(;[^,]*)?;base64,[A-Za-z0-9+/=]+$')
          && data.mimeType is string && data.mimeType.size() <= 80
          && data.mimeType.matches('^audio/(webm|mp4|ogg)(;.*)?$')
          && data.durationMs is int && data.durationMs >= 400 && data.durationMs <= 8000
          && data.caughtBy is map && data.caughtBy.size() <= 1
          && data.sentAt is timestamp && data.updatedAt is timestamp;
      }
      allow read: if isNightParticipant();
      allow create: if isActiveParticipant(night().coupleId)
        && night().status == 'active' && night().get('kissBookendVersion', 0) == 1
        && request.auth.uid == senderId
        && validNightKiss(request.resource.data)
        && request.resource.data.caughtBy.size() == 0
        && request.resource.data.sentAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isActiveParticipant(night().coupleId)
        && night().status == 'active' && night().get('kissBookendVersion', 0) == 1
        && isNightParticipant() && senderId in [night().players[0].uid, night().players[1].uid]
        && request.auth.uid != senderId
        && validNightKiss(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caughtBy', 'updatedAt'])
        && request.resource.data.audioData == resource.data.audioData
        && request.resource.data.mimeType == resource.data.mimeType
        && request.resource.data.durationMs == resource.data.durationMs
        && request.resource.data.sentAt == resource.data.sentAt
        && resource.data.caughtBy.size() == 0
        && request.resource.data.caughtBy.keys().hasOnly([request.auth.uid])
        && request.resource.data.caughtBy[request.auth.uid] == true
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /activities/{activityId} {
      allow create: if isAuthenticated()
        && isActiveParticipant(request.resource.data.coupleId) && isValidActivityCreate();

      allow read: if isParticipant(resource.data.coupleId);

      allow update: if isAuthenticated()
        && isActiveParticipant(resource.data.coupleId) && isValidActivityUpdate();

      allow delete: if false;
    }

    match /journalEntries/{entryId} {
      allow create: if isAuthenticated()
        && (isValidCompletedNightJournalEntry(request.resource.data)
          || (isValidJournalEntry(request.resource.data)
            && isActiveParticipant(request.resource.data.coupleId)
            && exists(
              /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
            )
            && get(
              /databases/$(database)/documents/sessions/$(request.resource.data.sessionId)
            ).data.coupleId == request.resource.data.coupleId));

      allow read: if isParticipant(resource.data.coupleId);
      allow update, delete: if false;
    }
  }
}
